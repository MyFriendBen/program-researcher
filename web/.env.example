# Required — Anthropic API key (same as the CLI tool)
RESEARCH_AGENT_ANTHROPIC_API_KEY=sk-ant-...

# Required — SMTP for emailing results
# For Gmail / Google Workspace:
#   1. Go to myaccount.google.com > Security > 2-Step Verification > App passwords
#   2. Generate an app password for "Mail"
#   3. Use that 16-character password as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=researcher@myfriendben.org
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=researcher@myfriendben.org

# Optional — pre-populate a dropdown of org emails on the form
ORG_EMAILS=elliott@myfriendben.org,someone@myfriendben.org

# Optional — Redis URL (set automatically by Heroku Redis add-on)
REDIS_URL=redis://localhost:6379

# Optional — simple password gate (leave blank for no auth)
APP_PASSWORD=

# Optional — Flask secret key (auto-set in production)
SECRET_KEY=change-me-in-production

# Optional — GitHub token for fetching sibling repo files at boot
# (needed if benefits-api / benefits-calculator are private)
GITHUB_TOKEN=ghp_...

# Optional — override branch for sibling repo files (default: main)
SIBLING_FILES_BRANCH=main

# Optional — Linear integration (for auto-posting tickets)
RESEARCH_AGENT_LINEAR_API_KEY=lin_api_...
RESEARCH_AGENT_LINEAR_TEAM_ID=
RESEARCH_AGENT_LINEAR_PROJECT_ID=
